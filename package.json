{
  "name": "seeded-grid-tool",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:playground": "vite --port 5174 --strictPort --open /playground.html",
    "typecheck": "tsc -b",
    "build": "npm run typecheck && npm run build:client",
    "build:client": "vite build",
    "preview:worker": "npm run build && wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "code-check": "oxlint -c .oxlintrc.json . && oxfmt --check .",
    "lint": "oxlint -c .oxlintrc.json .",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "precommit": "lint-staged",
    "test": "vitest run",
    "export:sync-test": "SYNC_EXPORT_TEST=1 vitest run src/lib/export/syncExportToTest.test.ts",
    "test:watch": "vitest",
    "verify": "npm test && concurrently --kill-others-on-fail -n tsc,vite -c yellow,cyan \"npm run typecheck\" \"npm run build:client\""
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,json,jsonc,css,md,yml,yaml}": [
      "oxfmt --write"
    ],
    "*.{js,jsx,ts,tsx}": [
      "oxlint -c .oxlintrc.json"
    ]
  },
  "dependencies": {
    "@chenglou/pretext": "^0.0.7",
    "@cloudflare/kumo": "^2.2.1",
    "@phosphor-icons/react": "^2.1.10",
    "@tailwindcss/vite": "^4.3.0",
    "clsx": "^2.1.1",
    "fflate": "^0.8.3",
    "highlight.js": "^11.11.1",
    "lowlight": "^3.3.0",
    "lucide-react": "^1.14.0",
    "motion": "^12.38.0",
    "pixi-box-shadow": "^1.2.1",
    "pixi.js": "^8.18.1",
    "prettier": "^3.8.3",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-hotkeys-hook": "^5.3.2",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.0",
    "zundo": "^2.3.0",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^9.2.1",
    "happy-dom": "^20.9.0",
    "jsdom": "^29.1.1",
    "lint-staged": "^16.4.0",
    "oxfmt": "^0.50.0",
    "oxlint": "^1.65.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.12",
    "vitest": "^4.1.6",
    "wrangler": "^4.91.0"
  }
}
