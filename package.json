{
  "name": "stripes-shader-monorepo",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.6.3",
  "pnpm": {
    "minimumReleaseAge": 10080,
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "workerd"
    ]
  },
  "scripts": {
    "dev": "pnpm --filter lab dev",
    "build": "pnpm --filter lab build",
    "build:client": "pnpm --filter lab build",
    "typecheck": "pnpm --filter @necatikcl/stripes-engine typecheck && pnpm --filter lab typecheck",
    "preview:worker": "pnpm --filter lab preview:worker",
    "deploy": "pnpm run build && pnpm exec wrangler deploy",
    "postinstall": "node ./scripts/workers-ci-build.mjs",
    "test": "vitest run --config vitest.workspace.ts",
    "test:watch": "vitest --config vitest.workspace.ts",
    "test:e2e": "playwright test",
    "test:e2e:update": "playwright test --update-snapshots",
    "verify": "pnpm run test && pnpm run typecheck && pnpm --filter lab build",
    "code-check": "oxlint -c .oxlintrc.json . && oxfmt --check .",
    "lint": "oxlint -c .oxlintrc.json .",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "prepare": "husky",
    "precommit": "lint-staged"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,json,jsonc,css,md,yml,yaml}": [
      "oxfmt --write --no-error-on-unmatched-pattern"
    ],
    "*.{js,jsx,ts,tsx}": [
      "oxlint -c .oxlintrc.json --no-error-on-unmatched-pattern"
    ]
  },
  "devDependencies": {
    "@playwright/test": "^1.61.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "oxfmt": "^0.48.0",
    "oxlint": "^1.63.0",
    "vitest": "^4.1.5"
  }
}
