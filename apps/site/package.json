{
  "name": "@cloudflare-connect/site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro build && astro preview",
    "deploy": "astro build && wrangler deploy",
    "astro": "astro",
    "cf-typegen": "wrangler types",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "fmt": "prettier --write .",
    "fmt:check": "prettier --check .",
    "check": "prettier --check . && eslint .",
    "fix": "prettier --write . && eslint . --fix",
    "icons:types": "tsx dev/vite/icons/emit-dts.ts",
    "textures:gen": "tsx dev/textures/generate.ts",
    "lottie-svg:gen": "tsx dev/vite/lottie-svg/emit.ts",
    "typecheck": "tsx dev/vite/icons/emit-dts.ts && tsx dev/vite/lottie-svg/emit.ts && wrangler types && astro check",
    "cc": "tsx dev/commands/create-component.ts --no-css",
    "cct": "tsx dev/commands/create-component.ts",
    "cca": "tsx dev/commands/create-component.ts --astro --no-css",
    "compress:videos": "tsx dev/commands/compressor/videos.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.0.0",
    "@astrojs/react": "^6.0.0",
    "@base-ui/react": "1.6.0",
    "@floating-ui/dom": "^1.7.6",
    "@floating-ui/react": "^0.27.19",
    "@necatikcl/stripes-engine": "workspace:*",
    "@react-three/drei": "10.0.7",
    "@react-three/fiber": "9.1.2",
    "@tailwindcss/vite": "^4.3.0",
    "@tjcages/connect-twizzler": "workspace:*",
    "@tjcages/panels": "0.1.0",
    "animejs": "^4.5.0",
    "astro": "^7.0.0",
    "classnames": "^2.5.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.14.0",
    "modgrad": "^0.1.4",
    "motion": "^12.42.0",
    "nanoid": "^5.1.16",
    "pixi.js": "^8.19.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "scheduler-polyfill": "^1.3.0",
    "shiki": "^4.3.0",
    "swiper": "^14.0.6",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.3.0",
    "three": "0.170.0",
    "usehooks-ts": "^3.1.1",
    "wiggle": "^0.0.17"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@eslint-react/eslint-plugin": "^5.9.0",
    "@eslint/js": "^10.0.0",
    "@types/node": "^26",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "0.170.0",
    "babel-plugin-react-compiler": "1.0.0",
    "chalk": "^5.6.2",
    "eslint": "^10.5.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-astro": "^2.1.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-unicorn": "^69.0.0",
    "globals": "^17.7.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.8",
    "prettier": "^3.9.1",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "tsx": "^4.22.4",
    "typescript": "^6.0.0",
    "typescript-eslint": "^8.62.0",
    "vite": "^8.0.16",
    "vite-plugin-svgr": "^5.2.0",
    "vitest": "^4.1.8",
    "wrangler": "^4.105.0"
  }
}
