const isPath = shape === "hexagon" || shape === "diamond";
const path = isPath ? paths[shape][size] : null;
---

<div
  {...rest}
  class:list={["absolute flex size-0 items-center justify-center", className]}
>
  <div
    data-chip
    data-active={active ? "" : undefined}
    data-chip-id={chipId}
    style={{ "--chip-base": `${sizePx}px` }}
    class:list={[
      "group/chip relative flex size-(--chip-px) shrink-0 items-center justify-center transition-[width,height,background-color,box-shadow]",
      "[--chip-px:var(--chip-base)]",
      grow && "data-active:[--chip-px:max(var(--chip-base),64px)]",
      !isPath &&
        "bg-background-surface shadow-elevation-faint data-active:bg-background-base data-active:shadow-elevation-default",
      shape === "circle" && "rounded-full",
      shape === "square" && "rounded-12",
    ]}
  >
    <div class="absolute inset-0 z-0 flex items-center justify-center">
      {path && (
        <svg
          class="shrink-0 origin-center scale-[calc(var(--chip-px)/var(--chip-base))] overflow-visible transition group-data-active/chip:filter-(--drop-shadow-elevation-default)"
          width={path.w}
          height={path.h}
          viewBox={path.viewBox}
          fill="none"
          aria-hidden="true"
        >
          <path
            class="fill-background-surface stroke-darker/4 transition group-data-active/chip:fill-background-base"
            d={path.d}
            vector-effect="non-scaling-stroke"
            stroke-width="2"
            paint-order="stroke"
          />
        </svg>
      )}
    </div>

    <div
      data-chip-content
      class:list={[
        "group/chip-content relative z-10 flex shrink-0 items-center justify-center transition duration-450 **:transition-[fill,stroke]",
        "text-icon-muted [--icon-color-primary:var(--color-icon-muted)] [--icon-color-secondary:var(--color-icon-faint)]",
        "group-data-active/chip:text-icon-default group-data-active/chip:[--icon-color-primary:var(--color-icon-default)] group-data-active/chip:[--icon-color-secondary:var(--color-icon-subtle)]",
        hideContentPassive &&
          "scale-75 opacity-0 blur-[2px] group-data-active/chip:scale-100 group-data-active/chip:opacity-100 group-data-active/chip:blur-none",
      ]}
    >
      <slot />
    </div>
  </div>
</div>
