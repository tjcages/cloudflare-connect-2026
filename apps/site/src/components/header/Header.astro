---
import DashedLine from "@/components/dashed-line/DashedLine";
import Button from "../Button";
import Icon from "../icon/Icon";
import ConnectHeaderLogo from "./ConnectHeaderLogo";
import HeaderLogo from "./HeaderLogo";
import HeaderNav from "./HeaderNav";
import MobileMenu from "./mobile/MobileMenu";
import { REGISTER_URL } from "@/components/_pages/connect/data";

interface Props {
  /** `connect` uses Agenda / Speakers / Resources dropdown. */
  variant?: "default" | "connect";
}

const { variant = "default" } = Astro.props;
const isConnect = variant === "connect";
---

<div class="h-80"></div>

<header class="fixed top-0 left-0 z-70 w-full bg-background-base">
  <div
    class="relative mx-auto w-full max-w-1200 px-16 py-24 before:inside-border-x before:inside-border-b before:z-20 before:border-border-default sm:px-40"
  >
    <DashedLine
      animateTowards="right"
      className="absolute -bottom-0.5 left-full z-20 w-screen text-border-default"
      direction="horizontal"
    />
    <DashedLine
      animateTowards="left"
      className="absolute right-full -bottom-0.5 z-20 w-screen text-border-default"
      direction="horizontal"
    />

    <div class="flex items-center">
      {isConnect ? <ConnectHeaderLogo /> : <HeaderLogo client:load />}

      <div class="mr-9.5 ml-23.5 flex-center h-full max-lg:hidden">
        <div class="h-13 w-px rounded-full bg-border-default"></div>
      </div>

      <HeaderNav
        client:load
        className="flex-1 max-lg:hidden"
        variant={variant}
      />

      <div class="ml-auto flex items-center gap-8 lg:hidden">
        {isConnect ? (
          <Button href={REGISTER_URL} size="default" variant="primary">
            <span>Register Now</span>
          </Button>
        ) : (
          <Button size="default" variant="primary">
            <span>Start building</span>
          </Button>
        )}

        <MobileMenu client:load variant={variant} />
      </div>

      <div class="flex gap-23 max-lg:hidden">
        <div class="flex">
          {isConnect ? (
            <>
              <Button
                href="/connect/convince-your-boss"
                size="default"
                className="mr-8 px-8"
                variant="ghost"
              >
                <span>Convince your boss</span>
              </Button>
              <Button href={REGISTER_URL} size="default" variant="primary">
                <span>Register Now</span>
              </Button>
            </>
          ) : (
            <>
              <Button
                className="px-8 hover:bg-background-alert-hover active:bg-background-alert-active"
                size="default"
                variant="ghost"
              >
                <Icon
                  className="text-icon-accent-warning!"
                  name="exclamation-circle"
                />
                <span class="text-text-accent-warning">Under attack?</span>
              </Button>

              <div class="mx-4 flex-center h-full w-12">
                <div class="h-13 w-px rounded-full bg-border-default" />
              </div>

              <Button size="default" className="mr-8 px-8" variant="ghost">
                <span>Log in</span>
              </Button>

              <Button size="default" variant="primary">
                <span>Start building</span>
              </Button>
            </>
          )}
        </div>
      </div>
    </div>
  </div>
</header>
