---
import CornerDots from "@/components/CornerDots";
import Eyebrow from "@/components/Eyebrow";
---

<div class="relative mx-auto max-w-1200">
  <div class="relative h-80">
    <CornerDots />
  </div>

  <div class="mx-auto flex w-640 flex-col items-center">
    <div class="flex flex-col items-center gap-24">
      <Eyebrow client:visible direction="center" title="explore" />

      <div class="flex flex-col gap-16 text-center">
        <h1 class="text-heading-h1 text-text-base"><slot name="heading" /></h1>
        <p class="text-body-large text-text-base">
          <slot name="description" />
        </p>
      </div>
    </div>
  </div>
</div>
