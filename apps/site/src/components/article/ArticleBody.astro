---
import { Image } from "astro:assets";
import {
  highlightCodePiece,
  resolveCodePieceLanguage,
} from "@/components/code-piece/highlighter";
import { detectArticleCodeLanguage } from "./code-language";
import CopyLink from "./CopyLink";
import { isLocalImage, resolveLocalImage } from "./local-image";
import RichText from "./RichText.astro";
import type { ArticleBlock } from "./types";

interface Props {
  blocks: ArticleBlock[];
  copyAnchors?: boolean;
  headingScale?: "display" | "section";
}

const { blocks, copyAnchors, headingScale = "display" } = Astro.props;
---

{blocks.map((block) => {
  if (block.type === "p") {
    return (
      <p class="text-blog-body text-text-base">
        <RichText text={block.text} />
      </p>
    );
  }

  if (block.type === "list") {
    const items = block.items.map((item) => (
      <li class="text-blog-body text-text-base">
        <RichText text={item} />
      </li>
    ));

    return block.ordered ? (
      <ol class="flex list-decimal flex-col gap-24 pl-26">{items}</ol>
    ) : (
      <ul class="flex list-disc flex-col gap-24 pl-26">{items}</ul>
    );
  }

  if (block.type === "heading") {
    const Heading = block.level === 2 ? "h2" : "h3";
    const anchored = Boolean(copyAnchors) && block.level === 2;
    const topClass =
      headingScale === "display" ? "text-blog-h1" : "text-blog-h2";

    return (
      <Heading
        class:list={[
          block.level === 2 ? topClass : "text-blog-h3",
          anchored && "relative",
          "text-text-base",
        ]}
        id={block.id}
      >
        {anchored && (
          <span class="absolute top-0 -left-52 flex-center size-44">
            <CopyLink client:visible hash={block.id} />
          </span>
        )}

        <RichText plainLinks text={block.text} />
      </Heading>
    );
  }

  if (block.type === "image") {
    return (
      <figure class="flex flex-col gap-12">
        {isLocalImage(block.src) ? (
          <Image
            alt={block.alt}
            class="w-full"
            loading="lazy"
            src={resolveLocalImage(block.src)}
          />
        ) : (
          <img alt={block.alt} class="w-full" loading="lazy" src={block.src} />
        )}

        {block.caption && (
          <figcaption class="text-body-small text-text-muted">
            <RichText text={block.caption} />
          </figcaption>
        )}
      </figure>
    );
  }

  if (block.type === "code") {
    const language = block.lang
      ? resolveCodePieceLanguage(block.lang)
      : detectArticleCodeLanguage(block.code);

    if (language) {
      return (
        <pre
          class="relative overflow-clip bg-background-surface p-20 text-code-default whitespace-pre-wrap text-text-default before:inside-border before:border-border-muted before:[transition:none]"
          set:html={highlightCodePiece(block.code, language)}
        />
      );
    }

    return (
      <pre
        class="relative overflow-clip bg-background-surface p-20 text-code-default whitespace-pre-wrap text-text-default before:inside-border before:border-border-muted before:[transition:none]"
        set:text={block.code}
      />
    );
  }

  if (block.type === "table") {
    return (
      <table class="w-full border-collapse text-left">
        <thead>
          <tr>
            {block.head.map((cell) => (
              <th class="relative px-12 py-8 text-blog-highlight text-text-base before:inside-border-b before:border-border-default before:[transition:none]">
                <RichText text={cell} />
              </th>
            ))}
          </tr>
        </thead>

        <tbody>
          {block.rows.map((row) => (
            <tr>
              {row.map((cell) => (
                <td class="relative px-12 py-8 align-top text-blog-body text-text-base before:inside-border-b before:border-border-muted before:[transition:none]">
                  <RichText text={cell} />
                </td>
              ))}
            </tr>
          ))}
        </tbody>
      </table>
    );
  }

  return (
    <blockquote class="relative flex flex-col gap-12 pl-24 before:inside-border-l before:border-border-default before:[transition:none]">
      <p class="text-blog-quote text-text-base">
        <RichText text={block.text} />
      </p>

      {block.cite && (
        <cite class="text-body-small text-text-muted not-italic">
          {block.cite}
        </cite>
      )}
    </blockquote>
  );
})}
