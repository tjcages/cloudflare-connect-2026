---
import Button from "@/components/Button";
import Eyebrow from "@/components/Eyebrow";
import Section from "@/layouts/Section.astro";
import CarouselContainer from "./CarouselContent";

export type CarouselProps = {
  title: string;
  description: string;
  href: string;
  type: "screenshot" | "automation" | "generation";
};

type Props = {
  eyebrowTitle: string;
  data: CarouselProps[];
};

const { eyebrowTitle, data } = Astro.props;
---

<Section
  layout="split-custom"
  eyebrow={eyebrowTitle}
  sectionEyebrow="Features"
  noGridArea
>
  <Fragment slot="custom">
    <Eyebrow client:visible direction="left" title={eyebrowTitle} />

    <div class="mt-24 mb-16 text-heading-h1 text-text-base">
      <slot name="title" />
    </div>

    <div class="mb-24 text-body-large text-text-base">
      <slot name="description" />
    </div>

    <Button variant="secondary" className="px-19!">
      <span>View docs</span>
    </Button>
  </Fragment>

  <CarouselContainer data={data} client:visible />
</Section>
