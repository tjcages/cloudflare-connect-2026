---
import Features from "@/components/features/Features.astro";
import Item from "@/components/features/Item.astro";
---

<Features>
  <Item iconName="arrows-zoom" title="Effortless scalability">
    No dedicated infrastructure or teams are needed for customer code execution.
    Workers for Platforms scales automatically on demand.
  </Item>

  <Item iconName="touch" title="Customer empowerment">
    Customers can customize experiences, trigger event-based actions, or extend
    your platform without needing your engineers to write code.
  </Item>

  <Item iconName="window-square-security" title="Secure code execution">
    Customer code runs in an isolated environment with built-in controls,
    eliminating security and compliance risks.
  </Item>
</Features>
