---
import type { AstroComponentFactory } from "astro/runtime/server/index.js";
import Button from "@/components/Button";
import DashedLine from "@/components/dashed-line/DashedLine";
import Stage from "@/components/Stage.astro";
import Section from "@/layouts/Section.astro";
import Automation from "./automation/Automation.astro";
import FullStackCanvas from "./FullStackCanvas";

const blocks: {
  title: string;
  body: string;
  stage?: AstroComponentFactory;
}[] = [
  {
    title: "Full-stack applications.",
    body: "Extend static sites into full-stack <br />applications with databases, KV-namespaces, and object storage, all within a managed execution environment.",
  },
  {
    title: "Personalized experiences.",
    body: "Enable customers to tailor sites with <br />custom logic, leveraging Cloudflare's global network for deployment and execution.",
  },
  {
    title: "Custom integrations.",
    body: "Extend platform capabilities with custom <br />integrations that scale on demand, without the need for extensive infrastructure.",
  },
  {
    title: "Event-driven automation.",
    body: "Empower customers to automate tasks <br />based on events, within a secure, isolated environment for code execution.",
    stage: Automation,
  },
];
---

<Section
  layout="sticky"
  eyebrow="Full Stack"
  sectionEyebrow="Features"
  title="You can use Workers for Platforms to:"
  description="See real-world examples of Cloudflare Workers for Platforms"
>
  <Button
    className="w-fit"
    href="https://developers.cloudflare.com/cloudflare-for-platforms/workers-for-platforms/"
    size="large"
    slot="action"
    variant="secondary"
  >
    <span>Start with Workers for Platforms</span>
  </Button>

  <div class="relative flex flex-col gap-56 p-40" data-wfp-fullstack-grid>
    {blocks.map(({ title, body, stage: StageVisual }, index) => (
      <Fragment>
        {index > 0 && (
          <div class="relative h-0">
            <DashedLine
              className="absolute inset-x-0 -top-0.5 w-full text-border-dashed"
              direction="horizontal"
            />
          </div>
        )}

        <div class="flex flex-col gap-24">
          {StageVisual ? <StageVisual /> : <Stage />}

          <p class="text-body-medium text-text-default">
            <span class="pr-3 text-label-medium text-text-base">{title}</span>{" "}
            <Fragment set:html={body} />
          </p>
        </div>
      </Fragment>
    ))}

    <FullStackCanvas client:only="react" />
  </div>
</Section>
