---
import type { AstroComponentFactory } from "astro/runtime/server/index.js";
import Button from "@/components/Button";
import DashedLine from "@/components/dashed-line/DashedLine";
import Section from "@/layouts/Section.astro";
import Enrich from "./enrich/Enrich.astro";
import FullStackCanvas from "./FullStackCanvas";
import Reply from "./reply/Reply.astro";
import Route from "./Route.astro";
import Send from "./Send.astro";

const blocks: {
  title: string;
  body: string;
  stage: AstroComponentFactory;
}[] = [
  {
    title: "Send from Workers.",
    body: "Trigger transactional and workflow email <br />directly from application logic.",
    stage: Send,
  },
  {
    title: "Enrich and orchestrate.",
    body: "Classify content with AI, store attachments, <br />and fan out async work with Queues.",
    stage: Enrich,
  },
  {
    title: "Route inbound email.",
    body: "Receive mail on your domain and hand it to <br />Workers for processing.",
    stage: Route,
  },
  {
    title: "Reply or escalate.",
    body: "Respond automatically, update state, or hand off <br />to downstream systems and humans.",
    stage: Reply,
  },
];
---

<Section
  layout="sticky"
  eyebrow="Full Stack"
  sectionEyebrow="Features"
  title="Email for agents"
  description="You can use Email Service to:"
>
  <Button
    className="w-fit px-20"
    href="https://developers.cloudflare.com/email-service/"
    size="large"
    slot="action"
    variant="secondary"
  >
    <span>View docs</span>
  </Button>

  <div class="relative flex flex-col gap-44 p-40" data-email-fullstack-grid>
    {blocks.map(({ title, body, stage: Stage }, index) => (
      <Fragment>
        {index > 0 && (
          <div class="relative h-0">
            <DashedLine
              className="absolute inset-x-0 -top-0.5 w-full text-border-dashed"
              direction="horizontal"
            />
          </div>
        )}

        <div class="flex flex-col gap-24">
          <Stage />

          <p class="text-body-medium text-text-default">
            <span class="pr-1 text-label-medium text-text-base">{title}</span>{" "}
            <Fragment set:html={body} />
          </p>
        </div>
      </Fragment>
    ))}

    <FullStackCanvas client:only="react" />
  </div>
</Section>
