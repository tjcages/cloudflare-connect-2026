---
import Features from "@/components/features/Features.astro";
import Item from "@/components/features/Item.astro";
---

<Features>
  <Item iconName="cursor-ai" title="Built for agents">
    Give agents a real inbox and the ability to send, receive and reply without
    stitching together third-party tools.
  </Item>

  <Item iconName="code-insert" title="Programmable by default">
    Route inbound email to Workers, process with AI, store attachments, and
    trigger workflows with code
  </Item>

  <Item iconName="arrow-split-right" title="One platform, bidirectional email">
    Combine email routing and email sending to handle the full email lifecycle
    on one platform.
  </Item>
</Features>
