---
import type { ImageMetadata } from "astro";
import { getImage } from "astro:assets";
import applicationServices from "@/assets/browser-rendering/application-services.png";
import applicationServicesDark from "@/assets/browser-rendering/application-services-dark.png";
import connectivityCloud from "@/assets/browser-rendering/connectivity-cloud.png";
import connectivityCloudDark from "@/assets/browser-rendering/connectivity-cloud-dark.png";
import developerPlatformScroll from "@/assets/browser-rendering/developer-platform-scroll.png";
import developerPlatformScrollDark from "@/assets/browser-rendering/developer-platform-scroll-dark.png";
import developerPlatform from "@/assets/browser-rendering/developer-platform.png";
import developerPlatformDark from "@/assets/browser-rendering/developer-platform-dark.png";
import Button from "@/components/Button";
import Icon from "@/components/icon/Icon";
import Scramble from "@/components/scramble/Scramble";
import WindowHero from "@/layouts/window-hero/WindowHero.astro";
import Dashboard from "./Dashboard";
import type { PageId, ThemeShots } from "./acts";

const getShots = async (
  sources: Record<Exclude<PageId, "developer-platform-scroll">, ImageMetadata>
) =>
  Object.fromEntries(
    await Promise.all(
      Object.entries(sources).map(
        async ([id, src]) =>
          [id, (await getImage({ src, width: 696, height: 392 })).src] as [
            PageId,
            string,
          ]
      )
    )
  ) as Record<PageId, string>;

const lightShots = await getShots({
  home: developerPlatform,
  "developer-platform": developerPlatform,
  "connectivity-cloud": connectivityCloud,
  "application-services": applicationServices,
});
lightShots["developer-platform-scroll"] = (
  await getImage({ src: developerPlatformScroll, width: 696, height: 1372 })
).src;

const darkShots = await getShots({
  home: developerPlatformDark,
  "developer-platform": developerPlatformDark,
  "connectivity-cloud": connectivityCloudDark,
  "application-services": applicationServicesDark,
});
darkShots["developer-platform-scroll"] = (
  await getImage({
    src: developerPlatformScrollDark,
    width: 696,
    height: 1372,
  })
).src;

const shots = {
  light: lightShots,
  dark: darkShots,
} satisfies ThemeShots;
---

<WindowHero>
  <Scramble
    slot="eyebrow"
    client:visible
    preset="eyebrow-hero"
    segments={[
      { text: "01 · ", className: "[word-spacing:4.75px]" },
      { text: "BROWSER RUN", className: "text-orange-900" },
    ]}
    className="text-decorative-small text-text-faint"
  />

  <Fragment slot="title">
    Headless, programmable web browsers built for <br />AI Agents
  </Fragment>

  <Fragment slot="description">
    <p>
      Give your application web browsing capabilities. <br />Spin up a web
      browser in the cloud on-demand, and <br />control it with your own code or
      AI-generated code.
    </p>
    <p>
      Take screenshots, extract text, run tests and automate <br />any workflow
      — even ones with no API to rely on.
    </p>
  </Fragment>

  <Fragment slot="action">
    <Button size="large" href="https://dash.cloudflare.com/sign-up">
      <Icon name="cloudflare" className="h-20 w-30" />
      <span>Start building for free</span>
    </Button>

    <Button
      variant="secondary"
      size="large"
      href="https://developers.cloudflare.com/browser-run/"
    >
      <span>View docs</span>
    </Button>
  </Fragment>

  <Dashboard client:visible shots={shots} />
</WindowHero>
