---
import Features from "@/components/features/Features.astro";
import Item from "@/components/features/Item.astro";
---

<Features>
  <Item iconName="lightning-bolt" title="Rapid deployment">
    Deploy full-stack applications quickly with Cloudflare Pages. A serverless
    platform for building and delivering trusted applications.
  </Item>

  <Item iconName="collaboration-pointer-left" title="Effortless collaboration">
    Share projects using unique, protected links with designers and developers
    to iterate quickly. All plans come with unlimited sites, seats, requests,
    and bandwidth.
  </Item>

  <Item iconName="globe-3" title="Global performance">
    The Cloudflare network delivers content mere milliseconds from users. Pages
    also supports HTTP/3, QUIC, image compression, and SSL out of the box.
  </Item>
</Features>
