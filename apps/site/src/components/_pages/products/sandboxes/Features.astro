---
import Features from "@/components/features/Features.astro";
import Item from "@/components/features/Item.astro";
---

<Features>
  <Item iconName="3d-box-top" title="Fully isolated">
    Each sandbox runs in its own secure container. Execute AI-generated or
    user-submitted code with zero risk to your infrastructure.
  </Item>

  <Item iconName="lightning-bolt" title="Fast spin-up">
    Sandboxes start in milliseconds, not minutes. Execute code immediately
    without waiting for cold starts.
  </Item>

  <Item iconName="code-insert" title="Bring your own images">
    Use standard container images with your own dependencies, tools, and
    runtimes. Full flexibility without lock-in.
  </Item>
</Features>
