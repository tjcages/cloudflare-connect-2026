---
import Button from "@/components/Button";
import Icon from "@/components/icon/Icon";
import Scramble from "@/components/scramble/Scramble";
import WindowHero from "@/layouts/window-hero/WindowHero.astro";
import SandboxRun from "./SandboxRun";
---

<WindowHero>
  <Scramble
    slot="eyebrow"
    client:visible
    preset="eyebrow-hero"
    segments={[
      { text: "06 · ", className: "[word-spacing:4.75px]" },
      { text: "SANDBOXES", className: "text-orange-900" },
    ]}
    className="text-decorative-small text-text-faint"
  />

  <Fragment slot="title">
    Secure code execution <br />for AI agents and <br />developer tools
  </Fragment>

  <Fragment slot="description">
    <p>
      Run untrusted code in isolated environments. Give your AI agents, <br
      />code interpreters, and developer tools a secure place to execute <br
      />code, install packages, and interact with the filesystem.
    </p>
  </Fragment>

  <Fragment slot="action">
    <Button size="large" href="https://dash.cloudflare.com/sign-up">
      <Icon name="cloudflare" className="h-20 w-30" />
      <span>Start building for free</span>
    </Button>

    <Button
      variant="secondary"
      size="large"
      href="https://developers.cloudflare.com/sandbox/"
    >
      <span>View docs</span>
    </Button>
  </Fragment>

  <SandboxRun client:visible />
</WindowHero>
