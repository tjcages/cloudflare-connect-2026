---
import Features from "@/components/features/Features.astro";
import Item from "@/components/features/Item.astro";
---

<Features>
  <Item iconName="code-insert" title="Programmable">
    Manage the full container lifecycle from <br />code in your Worker. No YAML
    or configuration language to learn.
  </Item>

  <Item iconName="globe-3" title="Global">
    Cloudflare automatically places each <br />instance in the optimal location
    across <br />our global network.
  </Item>

  <Item iconName="code-brackets" title="Simple">
    Deploy with one command, no devops experience required.
  </Item>
</Features>
