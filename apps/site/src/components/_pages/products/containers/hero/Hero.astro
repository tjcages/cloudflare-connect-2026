---
import type { IProductsBox } from "@/components/_animations/products/box/types";
import Products from "@/components/_animations/products/Products.astro";
import { compileBoxes } from "@/components/_animations/products/utils/compileBoxes";
import Button from "@/components/Button";
import CodePiece from "@/components/code-piece/CodePiece.astro";
import CornerDots from "@/components/CornerDots";
import HeroGrid from "@/components/hero-grid/HeroGrid.astro";
import Icon from "@/components/icon/Icon";
import Scramble from "@/components/scramble/Scramble";
import SectionEyebrow from "@/components/SectionEyebrow.astro";

const boxes: IProductsBox[] = compileBoxes([
  {
    id: "input",
    name: { text: "Input", position: "bottom" },
    icon: "hand-touch",
    size: 1,
    color: "red",
    position: { x: 160, y: 240 },
    connectTo: ["api"],
    connectToEdge: true,
  },
  {
    id: "api",
    name: { text: "API", position: "bottom" },
    icon: "cloud-api",
    size: 1,
    color: "blue",
    counter: {
      type: "routes",
      data: [
        { method: "GET", path: "/container/:id" },
        { method: "GET", path: "/lb" },
        { method: "POST", path: "/container" },
      ],
    },
    position: { x: 320, y: 80 },
    connectTo: ["containers"],
  },
  {
    id: "containers",
    name: { text: "Containers", position: "top", loud: true },
    icon: "product-containers",
    size: 3,
    color: "orange",
    position: { x: 480, y: 160 },
    connectTo: ["d1"],
  },
  {
    id: "d1",
    name: { text: "D1", position: "bottom" },
    icon: "product-d1",
    size: 1,
    color: "green",
    position: { x: 800, y: 80 },
    connectTo: ["r2"],
  },
  {
    id: "r2",
    name: { text: "R2", position: "bottom" },
    icon: "product-r2",
    size: 1,
    color: "orange",
    position: { x: 960, y: 240 },
    connectToEdge: true,
  },
]);
---

<div class="relative mx-auto max-w-1200 pt-280 pb-96">
  <HeroGrid />

  <SectionEyebrow text="Hero" />

  <CornerDots count={4} faintClassName="z-30" />

  <Products boxes={boxes} />

  <CodePiece
    duotone
    code={`const { "session-id": sessionId } = await request.json();`}
    align="right"
    class="absolute top-480 -left-80 w-240 *:data-code-decode:line-clamp-2"
  />

  <CodePiece
    duotone
    code={`import { Container, getContainer } from "@cloudflare/containers";`}
    align="left"
    class="absolute top-560 -right-80 w-320"
  />

  <div class="mx-auto max-w-640 select-auto">
    <Scramble
      client:visible
      preset="eyebrow-hero"
      segments={[
        { text: "03 · ", className: "[word-spacing:4.75px]" },
        { text: "CONTAINERS", className: "text-orange-900" },
      ]}
      className="py-32 text-center text-decorative-small text-text-faint"
    />

    <h1 class="mb-16 text-center text-heading-h1">
      Containers without <br />orchestration headaches
    </h1>

    <p class="mb-40 text-center text-body-large">
      Run containers globally with one command. No Kubernetes, no regions. <br
      />Run code written in any programming language, everywhere it's needed
      across Cloudflare's global network.
    </p>

    <div class="flex justify-center gap-12">
      <Button size="large" href="https://dash.cloudflare.com/sign-up">
        <Icon name="cloudflare" className="h-20 w-30" />
        <span>Start building for free</span>
      </Button>

      <Button
        variant="secondary"
        size="large"
        className="px-14"
        href="https://developers.cloudflare.com/containers/"
      >
        <span>View docs</span>
      </Button>
    </div>
  </div>
</div>
