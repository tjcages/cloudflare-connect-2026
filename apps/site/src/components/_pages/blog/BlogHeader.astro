---
import Eyebrow from "@/components/Eyebrow";
import BlogHeading from "./BlogHeading";

interface Props {
  eyebrow: string;
  title: string;
  description: string;
}

const { eyebrow, title, description } = Astro.props;
---

<div class="flex items-end gap-120">
  <div class="flex w-440 flex-col items-start gap-24">
    <Eyebrow client:visible direction="left" title={eyebrow} variant="faint" />

    <BlogHeading client:load title={title} />
  </div>

  <div class="flex w-480 items-center justify-center py-4">
    <p class="text-body-large text-text-base">{description}</p>
  </div>
</div>
