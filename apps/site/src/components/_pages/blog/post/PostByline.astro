---
import { formatPostDate, type Post } from "../data";
import PostAuthors from "./PostAuthors.astro";

interface Props {
  post: Post;
}

const { post } = Astro.props;
---

<div
  class="flex items-center justify-between gap-40 max-sm:flex-col max-sm:items-start max-sm:gap-12"
>
  <PostAuthors post={post} />

  <div class="flex items-center gap-16 whitespace-nowrap">
    <span class="text-body-x-small text-text-default">
      {formatPostDate(post.publishedAt)}
    </span>

    <span class="text-body-small text-text-subtle">·</span>

    <span class="text-body-x-small text-text-default">
      {post.readTime} min read
    </span>
  </div>
</div>
