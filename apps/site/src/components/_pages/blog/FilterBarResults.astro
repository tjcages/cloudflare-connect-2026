---
import { POSTS } from "./data";
import FilterBarGrid from "./FilterBarGrid.astro";
---

<div
  class="relative px-40 pb-80 max-lg:px-24 max-lg:pb-48"
  data-blog-results
  hidden
>
  <FilterBarGrid posts={POSTS} />

  <div data-blog-empty hidden>
    <p class="flex-center h-320 text-body-large text-text-muted">
      No posts match “<span data-blog-term></span>”.
    </p>
  </div>
</div>
