---
import Section from "@/layouts/Section.astro";

const stats = [
  { value: "42%", description: "Fortune 500 companies trust Cloudflare" },
  { value: "55M+", description: "HTTP requests served every second" },
  { value: "234B+", description: "Cyber threats blocked every day" },
];
---

<Section layout="headerless" noGridArea>
  <div class="flex justify-between px-80 max-lg:flex-col max-lg:gap-48 max-lg:px-24">
    <h2 class="w-320 text-heading-h2 text-text-base max-lg:w-full">
      Trusted by millions. Proven every second.
    </h2>

    <div class="flex w-520 flex-col gap-40 max-lg:w-full">
      {stats.map((stat, index) => (
        <div
          class:list={[
            "relative flex flex-col items-start gap-8 pb-40 whitespace-nowrap",
            index < stats.length - 1 &&
              "before:pointer-events-none before:absolute before:inset-x-0 before:bottom-0 before:h-px before:bg-border-muted",
          ]}
        >
          <div class="text-heading-h1 text-text-base">{stat.value}</div>
          <div class="text-body-medium text-text-default">
            {stat.description}
          </div>
        </div>
      ))}
    </div>
  </div>
</Section>
