---
import Button from "@/components/Button";
import CornerDots from "@/components/CornerDots";
import Eyebrow from "@/components/Eyebrow";
---

<div
  class="relative mx-auto max-w-1200 before:inside-border-b before:border-border-default"
>
  <CornerDots count={4} faintClassName="z-30" />

  <div class="flex justify-between px-80 pt-80 pb-160">
    <div class="flex w-440 flex-col items-start">
      <Eyebrow
        client:visible
        direction="left"
        title="Case Studies"
        variant="faint"
      />

      <h1 class="mt-24 text-heading-hero text-text-base">
        You’re in <br />good company
      </h1>

      <Button className="mt-40 px-14" href="#" size="large">
        <span>Contact enterprise sales</span>
      </Button>
    </div>

    <div class="mt-80 w-480 self-start py-4">
      <p class="text-body-large text-text-base">
        Learn how companies like yours are leveraging our platform. Cloudflare
        provides Security, Performance, and Reliability <br />for anything
        connected to the Internet.
      </p>
    </div>
  </div>

  <div class="h-80"></div>
</div>
