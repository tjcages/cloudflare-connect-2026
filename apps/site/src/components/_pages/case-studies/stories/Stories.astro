---
import Section from "@/layouts/Section.astro";
import StoriesTable from "./StoriesTable";
---

<Section layout="headerless" noGridArea>
  <div class="px-80 pt-40">
    <h2 class="max-w-690 text-heading-h2">
      <span class="text-text-base">
        Powering more than 33,000 organizations.
      </span>{" "}
