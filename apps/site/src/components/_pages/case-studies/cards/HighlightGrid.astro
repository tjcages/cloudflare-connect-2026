---
import Container from "@/components/Container.astro";
import Card from "./Card.astro";
---

<Container>
  <div class="relative flex flex-col gap-40 px-40 pb-80">
    <div class="-mt-160 flex gap-40">
      <Card name="skyscanner" width={640} />
      <Card name="shopify" width={440} />
    </div>

    <div class="flex gap-40">
      <Card name="uniswap" width={440} />
      <Card name="discord" width={640} />
    </div>

    <div class="flex justify-between">
      <Card name="anadolu-efes" width={320} />
      <div class="w-1 bg-border-muted"></div>
      <Card name="delivery-hero" width={320} />
      <div class="w-1 bg-border-muted"></div>
      <Card name="envato" width={320} />
    </div>
  </div>
</Container>
