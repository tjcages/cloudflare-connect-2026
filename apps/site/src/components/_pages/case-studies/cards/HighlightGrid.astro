---
import Container from "@/components/Container.astro";
import Card from "./Card.astro";
---

<Container>
  <div
    class="relative flex flex-col gap-40 px-40 pb-80 max-lg:px-24 max-lg:pb-48"
  >
    <div class="-mt-160 flex gap-40 max-lg:mt-0 max-lg:flex-col">
      <Card name="skyscanner" width={640} />
      <Card name="shopify" width={440} />
    </div>

    <div class="flex gap-40 max-lg:flex-col">
      <Card name="uniswap" width={440} />
      <Card name="discord" width={640} />
    </div>

    <div class="flex justify-between max-lg:flex-col max-lg:gap-40">
      <Card name="anadolu-efes" width={320} />
      <div class="w-1 bg-border-muted max-lg:hidden"></div>
      <Card name="delivery-hero" width={320} />
      <div class="w-1 bg-border-muted max-lg:hidden"></div>
      <Card name="envato" width={320} />
    </div>
  </div>
</Container>
