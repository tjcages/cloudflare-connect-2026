---
import Button from "@/components/Button";
import Icon from "@/components/icon/Icon";
import Section from "@/layouts/Section.astro";
import { connectTicketIncludes, connectTickets } from "../data";
---

<Section
  class="scroll-mt-80"
  layout="split-custom"
  sectionEyebrow="Tickets"
  id="tickets"
>
  <div slot="custom" class="flex items-end justify-between">
    <div>
      <h2 class="mb-16 text-heading-h2 text-balance text-text-base">
        Don’t just anticipate the future. Build it.
      </h2>
      <div class="max-w-520 text-body-large text-balance text-text-base">
        Conference access, optional University training, and evenings built for
        connections.
      </div>

      <div class="mt-32 flex flex-col gap-12">
        <span class="text-decorative-tiny text-text-muted">
          Each ticket includes
        </span>

        <ul class="flex flex-wrap gap-8">
          {connectTicketIncludes.map((item) => (
            <li class="relative inline-flex items-center gap-8 rounded-full bg-background-surface px-12 py-6 text-label-x-small text-text-accent-orange before:inside-border before:border-dashed before:border-orange-900/40">
              <Icon name="circle-check" size={16} />
              <span>{item}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </div>

  <div class="relative before:inside-border before:border-border-default">
    <div class="relative grid grid-cols-2 max-md:grid-cols-1">
      {connectTickets.map((ticket) => (
        <div class="relative flex flex-col gap-24 p-40 max-lg:p-24">
          <div class="text-decorative-small text-text-faint uppercase">
            {ticket.name}
          </div>
          <div class="text-heading-h1 text-text-base">{ticket.price}</div>
          <p class="text-body-medium text-text-default">{ticket.detail}</p>
          <Button
            className="mt-auto self-start"
            href={ticket.href}
            size="large"
          >
            <span>{ticket.cta}</span>
          </Button>
        </div>
      ))}
    </div>
  </div>

  <Fragment slot="info">
    <span class="contents text-label-x-small">$100 off</span> for government, military,
    nonprofit, and education (.gov / .mil / .org / .edu).
  </Fragment>
</Section>
