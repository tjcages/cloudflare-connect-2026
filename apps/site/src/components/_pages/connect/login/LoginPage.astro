---
import ConnectHeroTwizzler from "../hero/ConnectHeroTwizzler";
import DashboardLoginForm from "./DashboardLoginForm";
import LoginPromo from "./LoginPromo.astro";
import { LOGIN_OVERLAY_COPY } from "./login-copy";
import {
  LOGIN_MOBILE_SCRIM,
  LOGIN_MOBILE_TWIZZLER_DEFAULTS,
  LOGIN_PANEL_TARGETS,
  LOGIN_RAIN_DEFAULT,
  LOGIN_TWIZZLER_DEFAULTS,
} from "./login-shader";

const SIGN_UP_HREF = "https://dash.cloudflare.com/sign-up";
---

{/*
  1:1 dash.cloudflare.com/login chrome (Kumo). The globe is the only
  substitution: homepage hero Twizzler + rain, Dark Appearance (cream
  ribbon on deep orange). Below lg a contained Connect card sits under
  the nav and above “Sign in to Cloudflare”.
*/}
<div class="dash-login relative min-h-screen bg-[#ffffff] text-[#1d1d1d]">
  <div class="relative">
    <header
      class="dash-login-chrome absolute inset-x-0 top-20 z-10 flex items-center justify-between px-16"
    >
    <a
      aria-label="Cloudflare"
      href="https://www.cloudflare.com/"
      rel="noreferrer"
      target="_blank"
    >
      <svg
        aria-hidden="true"
        height="47"
        role="img"
        viewBox="0 0 460 271.2"
        width="80"
      >
        <path
          d="M328.6,125.6c-0.8,0-1.5,0.6-1.8,1.4l-4.8,16.7c-2.1,7.2-1.3,13.8,2.2,18.7    c3.2,4.5,8.6,7.1,15.1,7.4l26.2,1.6c0.8,0,1.5,0.4,1.9,1c0.4,0.6,0.5,1.5,0.3,2.2c-0.4,1.2-1.6,2.1-2.9,2.2l-27.3,1.6    c-14.8,0.7-30.7,12.6-36.3,27.2l-2,5.1c-0.4,1,0.3,2,1.4,2h93.8c1.1,0,2.1-0.7,2.4-1.8c1.6-5.8,2.5-11.9,2.5-18.2    c0-37-30.2-67.2-67.3-67.2C330.9,125.5,329.7,125.5,328.6,125.6z"
          fill="#FBAD41"></path>
        <path
          d="M292.8,204.4c2.1-7.2,1.3-13.8-2.2-18.7c-3.2-4.5-8.6-7.1-15.1-7.4l-123.1-1.6    c-0.8,0-1.5-0.4-1.9-1s-0.5-1.4-0.3-2.2c0.4-1.2,1.6-2.1,2.9-2.2l124.2-1.6c14.7-0.7,30.7-12.6,36.3-27.2l7.1-18.5    c0.3-0.8,0.4-1.6,0.2-2.4c-8-36.2-40.3-63.2-78.9-63.2c-35.6,0-65.8,23-76.6,54.9c-7-5.2-15.9-8-25.5-7.1    c-17.1,1.7-30.8,15.4-32.5,32.5c-0.4,4.4-0.1,8.7,0.9,12.7c-27.9,0.8-50.2,23.6-50.2,51.7c0,2.5,0.2,5,0.5,7.5    c0.2,1.2,1.2,2.1,2.4,2.1h227.2c1.3,0,2.5-0.9,2.9-2.2L292.8,204.4z"
          fill="#F6821F"></path>
      </svg>
    </a>
    <div class="flex items-center gap-8">
      <button
        aria-haspopup="menu"
        class="inline-flex h-36 shrink-0 items-center gap-6 rounded-[8px] bg-transparent px-12 text-[16px] leading-24 font-medium text-[#1d1d1d] hover:bg-[#f4f4f4]/80"
        type="button"
      >
        <svg
          aria-hidden="true"
          fill="currentColor"
          height="16"
          viewBox="0 0 256 256"
          width="16"
          xmlns="http://www.w3.org/2000/svg"
        >
          <path
            d="M128,24h0A104,104,0,1,0,232,128,104.12,104.12,0,0,0,128,24Zm88,104a87.61,87.61,0,0,1-3.33,24H174.16a157.44,157.44,0,0,0,0-48h38.51A87.61,87.61,0,0,1,216,128ZM102,168H154a115.11,115.11,0,0,1-26,45A115.27,115.27,0,0,1,102,168Zm-3.9-16a140.84,140.84,0,0,1,0-48h59.88a140.84,140.84,0,0,1,0,48ZM40,128a87.61,87.61,0,0,1,3.33-24H81.84a157.44,157.44,0,0,0,0,48H43.33A87.61,87.61,0,0,1,40,128ZM154,88H102a115.11,115.11,0,0,1,26-45A115.27,115.27,0,0,1,154,88Zm52.33,0H170.71a135.28,135.28,0,0,0-22.3-45.6A88.29,88.29,0,0,1,206.37,88ZM107.59,42.4A135.28,135.28,0,0,0,85.29,88H49.63A88.29,88.29,0,0,1,107.59,42.4ZM49.63,168H85.29a135.28,135.28,0,0,0,22.3,45.6A88.29,88.29,0,0,1,49.63,168Zm98.78,45.6a135.28,135.28,0,0,0,22.3-45.6h35.66A88.29,88.29,0,0,1,148.41,213.6Z"
          ></path>
        </svg>
        <span class="inline-flex items-center">
          English
          <svg
            aria-hidden="true"
            fill="currentColor"
            height="14"
            viewBox="0 0 256 256"
            width="14"
            xmlns="http://www.w3.org/2000/svg"
          >
            <path
              d="M213.66,101.66l-80,80a8,8,0,0,1-11.32,0l-80-80A8,8,0,0,1,53.66,90.34L128,164.69l74.34-74.35a8,8,0,0,1,11.32,11.32Z"
            ></path>
          </svg>
        </span>
      </button>
      <a
        class="inline-flex h-36 shrink-0 items-center rounded-[8px] bg-[#ffffff] px-12 text-[16px] leading-24 font-medium text-[#1d1d1d] no-underline shadow-[0_1px_2px_rgb(0_0_0_/_0.05)] ring-1 ring-[#d6d6d6] hover:bg-[#f4f4f4]"
        href={SIGN_UP_HREF}
      >
        Sign up
      </a>
    </div>
  </header>

  <div class="flex min-h-screen w-full overflow-x-hidden">
    <main
      class="flex min-w-0 flex-1 flex-col items-center bg-[#ffffff]"
    >
      <div
        class="w-full max-w-[28rem] px-16 pt-88 min-[1024px]:hidden"
      >
        <a
          aria-label="Cloudflare Connect"
          class="group relative isolate block overflow-hidden rounded-[12px] bg-[#f86a00] px-16 py-20 no-underline shadow-[0_1px_2px_rgb(0_0_0_/_0.05)] ring-1 ring-[#d6d6d6]"
          href={LOGIN_OVERLAY_COPY.bannerHref}
          rel="noreferrer"
          target="_blank"
        >
          <div class="pointer-events-none absolute inset-0 z-0 h-full w-full">
            <ConnectHeroTwizzler
              client:media="(max-width: 1023px)"
              defaults={LOGIN_MOBILE_TWIZZLER_DEFAULTS}
              hideTopFade={true}
              panelTargets={LOGIN_PANEL_TARGETS}
              rainDefaults={LOGIN_RAIN_DEFAULT}
            />
          </div>
          <div
            aria-hidden="true"
            class="pointer-events-none absolute inset-0 z-[1]"
            style={{ backgroundImage: LOGIN_MOBILE_SCRIM }}
          />
          <LoginPromo layout="banner" />
        </a>
      </div>
      <div
        class="dash-login-chrome flex w-full min-w-0 flex-1 items-start justify-center"
      >
        <DashboardLoginForm client:load />
      </div>
    </main>

    <aside
      aria-label="Cloudflare Connect 2026"
      class="relative hidden min-w-0 max-w-[800px] flex-1 overflow-hidden border-l border-[#e8e8e8] min-[1024px]:sticky min-[1024px]:top-0 min-[1024px]:block min-[1024px]:h-screen min-[1024px]:self-start"
    >
      {/* pt-96 + promo pt-24 matches the form heading (pt-96 + py-24). */}
      <div
        class="relative flex h-full min-h-full items-start overflow-hidden bg-[#f86a00] px-40 pt-96 pb-40 min-[1280px]:px-64 min-[1280px]:pb-64"
      >
        <div class="pointer-events-none absolute inset-0 z-0 h-full w-full">
          <ConnectHeroTwizzler
            client:media="(min-width: 1024px)"
            defaults={LOGIN_TWIZZLER_DEFAULTS}
            panelTargets={LOGIN_PANEL_TARGETS}
            rainDefaults={LOGIN_RAIN_DEFAULT}
          />
        </div>
        <LoginPromo />
      </div>
    </aside>
  </div>

  <div class="dash-login-chrome absolute bottom-8 left-8 z-10">
    <a
      class="inline-flex items-center gap-6 text-[13px] leading-[1.5] font-normal text-[#0051c3] no-underline hover:underline"
      href="https://www.cloudflare.com/privacypolicy/"
      rel="noreferrer"
      target="_blank"
    >
      <img
        alt=""
        class="h-15 w-30"
        height="15"
        src="data:image/svg+xml,%3csvg enable-background='new 0 0 30 14' version='1.1' viewBox='0 0 30 14' xml:space='preserve' xmlns='http://www.w3.org/2000/svg'%3e%3cstyle type='text/css'%3e .st0%7bfill-rule:evenodd;clip-rule:evenodd;fill:%23FFFFFF;%7d .st1%7bfill-rule:evenodd;clip-rule:evenodd;fill:%230066FF;%7d .st2%7bfill:%23FFFFFF;%7d .st3%7bfill:%230066FF;%7d %3c/style%3e%3cg transform='translate(-1275 -200)'%3e%3cg transform='translate(1275 200)'%3e%3cpath class='st0' d='m7.4 12.8h6.8l3.1-11.6h-9.9c-3.2 0-5.8 2.6-5.8 5.8s2.6 5.8 5.8 5.8z'/%3e%3c/g%3e%3c/g%3e%3cg transform='translate(-1275 -200)'%3e%3cg transform='translate(1275 200)'%3e%3cpath class='st1' d='m22.6 0h-15.2c-3.9 0-7 3.1-7 7s3.1 7 7 7h15.2c3.9 0 7-3.1 7-7s-3.2-7-7-7zm-21 7c0-3.2 2.6-5.8 5.8-5.8h9.9l-3.1 11.6h-6.8c-3.2 0-5.8-2.6-5.8-5.8z'/%3e%3cpath class='st2' d='m24.6 4c0.2 0.2 0.2 0.6 0 0.8l-2.1 2.2 2.2 2.2c0.2 0.2 0.2 0.6 0 0.8s-0.6 0.2-0.8 0l-2.2-2.2-2.2 2.2c-0.2 0.2-0.6 0.2-0.8 0s-0.2-0.6 0-0.8l2.1-2.2-2.2-2.2c-0.2-0.2-0.2-0.6 0-0.8s0.6-0.2 0.8 0l2.2 2.2 2.2-2.2c0.2-0.2 0.6-0.2 0.8 0z'/%3e%3cpath class='st3' d='m12.7 4.1c0.2 0.2 0.3 0.6 0.1 0.8l-4.2 4.9c-0.1 0.1-0.2 0.2-0.3 0.2-0.2 0.1-0.5 0.1-0.7-0.1l-2.2-2.2c-0.2-0.2-0.2-0.6 0-0.8s0.6-0.2 0.8 0l1.8 1.7 3.8-4.5c0.2-0.2 0.6-0.2 0.9 0z'/%3e%3c/g%3e%3c/g%3e%3c/svg%3e"
        width="30"
      />
      Cookie Preferences
    </a>
  </div>
  </div>
</div>
