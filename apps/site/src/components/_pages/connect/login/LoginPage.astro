---
import ConnectHeroTwizzler from "../hero/ConnectHeroTwizzler";
import DashboardLoginForm from "./DashboardLoginForm";
import LoginPromo from "./LoginPromo.astro";
import { LOGIN_PANEL_TARGETS } from "./login-shader";
---

{/*
    Desktop: dash split (form | visual). Promo is top-centered over the
    shader, using the dash.cloudflare.com overlay copy.

    Mobile: shader is a bounded visual panel (the moth/ribbon) with a
    compact callout floating at its top. The form sits below as an
    opaque white sheet so the canvas cannot paint over it.
  */}
<div class="relative min-h-svh bg-white lg:flex" data-theme="light">
  <aside
    class="relative isolate overflow-hidden max-lg:h-[42svh] max-lg:min-h-280 lg:order-2 lg:h-svh lg:flex-1"
    aria-label="Cloudflare Connect 2026"
  >
    <div class="pointer-events-none absolute inset-0" aria-hidden="true">
      <ConnectHeroTwizzler
        client:load
        hideTopFade={true}
        panelTargets={LOGIN_PANEL_TARGETS}
        posterSrc="/connect/twizzler-poster.png"
      />
    </div>

    <div
      class="pointer-events-none absolute inset-x-16 top-16 z-20 lg:hidden"
    >
      <div
        class="transform-gpu rounded-12 bg-white px-16 py-12 shadow-elevation-default"
      >
        <LoginPromo size="callout" />
      </div>
    </div>

    <div
      class="pointer-events-none absolute inset-x-0 top-0 z-10 hidden px-40 pt-24 lg:flex lg:justify-center xl:pt-32"
    >
      <LoginPromo size="pane" />
    </div>
  </aside>

  <main
    class="relative z-20 bg-white max-lg:min-h-0 lg:order-1 lg:h-svh lg:w-480 lg:border-r lg:border-border-default xl:w-520"
  >
    <DashboardLoginForm client:load />
  </main>
</div>
