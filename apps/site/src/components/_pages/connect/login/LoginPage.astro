---
import Button from "@/components/Button";
import Eyebrow from "@/components/Eyebrow";
import { connectHero } from "../data";
import ConnectHeroTwizzler from "../hero/ConnectHeroTwizzler";
import DashboardLoginForm from "./DashboardLoginForm";
import { LOGIN_PANEL_TARGETS } from "./login-shader";
---

<div class="bg-white flex min-h-svh max-lg:flex-col" data-theme="light">
  <main
    class="w-full shrink-0 border-border-default lg:w-480 lg:border-r xl:w-520"
  >
    <DashboardLoginForm client:load />
  </main>

  <aside
    class="relative isolate flex min-h-svh flex-1 overflow-hidden bg-background-base max-lg:min-h-640"
    aria-label="Cloudflare Connect 2026"
  >
    <div class="pointer-events-none absolute inset-0" aria-hidden="true">
      <ConnectHeroTwizzler
        client:load
        panelTargets={LOGIN_PANEL_TARGETS}
        posterSrc="/connect/twizzler-poster.png"
      />
    </div>

    <div
      class="relative z-10 flex w-full flex-col justify-between gap-40 px-24 py-48 md:px-80 md:py-80"
    >
      <div class="flex w-full max-w-440 flex-col items-start">
        <Eyebrow
          client:visible
          direction="left"
          title={connectHero.eyebrow}
          variant="faint"
        />

        <h2 class="mt-24 text-heading-hero text-text-base">
          {connectHero.titleLines[0]}
          <br />
          {connectHero.titleLines[1]}
        </h2>

        <p class="mt-24 text-body-large text-text-base">{connectHero.body}</p>

        <div class="mt-40 flex flex-wrap items-center gap-12">
          <Button
            className="px-14"
            href={connectHero.primaryCta.href}
            size="large"
          >
            <span>{connectHero.primaryCta.text}</span>
          </Button>
          <Button
            href={connectHero.secondaryCta.href}
            size="large"
            variant="secondary"
          >
            <span>{connectHero.secondaryCta.text}</span>
          </Button>
        </div>
      </div>
    </div>
  </aside>
</div>
