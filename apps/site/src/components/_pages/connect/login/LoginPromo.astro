---
import Eyebrow from "@/components/Eyebrow";
import HoverArrow from "@/components/HoverArrow";
import { LOGIN_OVERLAY_COPY } from "./login-copy";
---

<div
  class="relative z-10 flex w-full max-w-320 flex-col items-start pt-24 text-text-inverse"
>
  <Eyebrow
    client:visible
    direction="left"
    style={{
      "--eyebrow-color-badge": "var(--color-background-base)",
      "--eyebrow-color-badge-text": "var(--color-text-base)",
      "--eyebrow-color-line-big": "var(--color-text-inverse)",
      "--eyebrow-color-line-small":
        "color-mix(in srgb, var(--color-text-inverse) 55%, transparent)",
    }}
    title={LOGIN_OVERLAY_COPY.eyebrow}
  />

  <h2 class="mt-16 text-heading-h3 text-text-inverse">
    {LOGIN_OVERLAY_COPY.titleLines[0]}
    <br />
    {LOGIN_OVERLAY_COPY.titleLines[1]}
  </h2>

  <p class="mt-16 text-body-medium text-text-inverse">
    {LOGIN_OVERLAY_COPY.body}.{" "}
    <a
      class="group inline-flex items-center text-body-medium text-text-inverse transition-colors duration-150 hover:text-orange-900"
      href={LOGIN_OVERLAY_COPY.registerHref}
      rel="noopener noreferrer"
      target="_blank"
    >
      {LOGIN_OVERLAY_COPY.register}
      <HoverArrow className="-ml-4" />
    </a>
  </p>
</div>
