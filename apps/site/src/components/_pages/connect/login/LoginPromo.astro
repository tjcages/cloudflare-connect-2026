---
import Button from "@/components/Button";
import Eyebrow from "@/components/Eyebrow";
import { LOGIN_OVERLAY_COPY } from "./login-copy";
---

<div class="relative z-10 flex w-full max-w-440 flex-col items-start">
  <Eyebrow
    client:visible
    direction="left"
    title={LOGIN_OVERLAY_COPY.eyebrow}
    variant="faint"
  />

  <h2 class="mt-24 text-heading-hero text-text-base">
    {LOGIN_OVERLAY_COPY.titleLines[0]}
    <br />
    {LOGIN_OVERLAY_COPY.titleLines[1]}
  </h2>

  <p class="mt-24 text-body-large text-text-base">{LOGIN_OVERLAY_COPY.body}</p>

  <div class="mt-40">
    <Button
      className="px-14"
      href={LOGIN_OVERLAY_COPY.registerHref}
      rel="noopener noreferrer"
      size="large"
      target="_blank"
    >
      <span>{LOGIN_OVERLAY_COPY.register}</span>
    </Button>
  </div>
</div>
