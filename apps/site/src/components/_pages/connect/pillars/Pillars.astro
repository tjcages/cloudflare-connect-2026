---
import Item from "@/components/features/Item.astro";
import DashedLineGrid from "@/components/dashed-line/DashedLineGrid";
import Section from "@/layouts/Section.astro";
import { connectPillars } from "../data";
---

<Section
  layout="center"
  eyebrow="Why attend"
  sectionEyebrow="Features"
  title="Why attend Cloudflare Connect?"
  description="Spend three days with the builders of the network behind more than 20% of the web."
  headerClass="pb-72!"
>
  <div
    class="relative grid grid-cols-3 before:inside-border before:border-border-default"
  >
    {connectPillars.map((pillar) => (
      <Item class="h-262" iconName={pillar.iconName} title={pillar.title}>
        {pillar.body}
      </Item>
    ))}

    <DashedLineGrid
      client:visible={{ rootMargin: "200px" }}
      columns={3}
      rows={2}
    />
  </div>
</Section>
