---
import Button from "@/components/Button";
import CornerDots from "@/components/CornerDots";
import Eyebrow from "@/components/Eyebrow";
import { connectHero } from "../data";
import ConnectHeroTwizzler from "./ConnectHeroTwizzler";
---

<div
  class="relative isolate mx-auto min-h-760 max-w-1200 overflow-hidden before:inside-border-b before:border-border-default md:min-h-616"
>
  <CornerDots count={4} faintClassName="z-30" />

  <div
    class="pointer-events-none absolute inset-x-0 -bottom-48 z-0 h-320 md:-bottom-96 md:h-520"
    aria-hidden="true"
  >
    <ConnectHeroTwizzler client:load posterSrc="/connect/twizzler-poster.png" />
  </div>

  <div
    class="relative z-10 flex flex-col gap-32 px-24 pt-48 pb-160 md:flex-row md:justify-between md:gap-0 md:px-80 md:pt-80"
  >
    <div class="flex w-full flex-col items-start md:w-440">
      <Eyebrow
        client:visible
        direction="left"
        title={connectHero.eyebrow}
        variant="faint"
      />

      <h1 class="mt-24 text-heading-hero text-text-base">
        {connectHero.titleLines[0]}
        <br />
        {connectHero.titleLines[1]}
      </h1>
    </div>

    <div class="w-full self-start py-4 md:w-480 md:self-end md:py-0">
      <p class="text-body-large text-text-base">{connectHero.body}</p>

      <div class="mt-40 flex flex-wrap items-center gap-12">
        <Button
          className="px-14"
          href={connectHero.primaryCta.href}
          size="large"
        >
          <span>{connectHero.primaryCta.text}</span>
        </Button>
        <Button
          href={connectHero.secondaryCta.href}
          size="large"
          variant="secondary"
        >
          <span>{connectHero.secondaryCta.text}</span>
        </Button>
      </div>
    </div>
  </div>

  <div class="relative z-10 h-80"></div>
</div>
