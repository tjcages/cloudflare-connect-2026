---
import Button from "@/components/Button";
import DashedLine from "@/components/dashed-line/DashedLine";
import Eyebrow from "@/components/Eyebrow";
import Section from "@/layouts/Section.astro";
import { type AgendaSlotAccent, connectAgenda, connectHero } from "../data";
import AgendaRainOverlay from "./AgendaRainOverlay";

// Written out in full so Tailwind sees each class literally.
const SLOT_DOT: Record<AgendaSlotAccent, string> = {
  info: "bg-background-accent-info",
  orange: "bg-background-accent-orange",
  success: "bg-background-accent-success",
};
---

<Section
  class="scroll-mt-80"
  id="agenda"
  layout="sticky"
  eyebrow="Agenda"
  sectionEyebrow="Schedule"
  title="Agenda at-a-glance"
  description="Three days of keynotes, hands-on training, breakouts, and after-hours at Moscone West."
>
  <Button href={connectHero.primaryCta.href} size="large" slot="action">
    <span>Register Now</span>
  </Button>

  <div data-agenda-rain-root class="relative flex flex-col gap-48 p-40">
    {connectAgenda.map((item, index) => (
      <Fragment>
        {index > 0 && (
          <div class="relative h-0">
            <DashedLine
              className="absolute inset-x-0 -top-0.5 w-full text-border-dashed"
              direction="horizontal"
            />
          </div>
        )}

        <div class="flex flex-col gap-16">
          <div
            data-agenda-rain-aperture
            class="relative h-200 overflow-clip bg-background-surface after:inside-border after:z-20 after:border-border-muted"
          >
            <div class="relative z-10 flex size-full flex-col justify-end gap-8 p-32">
              <Eyebrow
                client:visible
                direction="left"
                title={item.day}
                variant="faint"
              />
              <div class="text-heading-h3 text-orange-900">{item.date}</div>
            </div>
          </div>

          <div class="flex flex-col">
            {item.slots.map((slot, slotIndex) => (
              <div class="flex gap-16">
                <div class="relative flex w-6 flex-col items-center">
                  <span
                    class:list={[
                      "mt-5 size-6 shrink-0 rounded-full",
                      SLOT_DOT[slot.accent],
                    ]}
                  />

                  {slotIndex < item.slots.length - 1 && (
                    <DashedLine
                      className="absolute top-17 bottom-0 text-border-dashed"
                      direction="vertical"
                    />
                  )}
                </div>

                <div
                  class:list={[
                    "flex min-w-0 flex-col gap-8",
                    slotIndex < item.slots.length - 1 && "pb-24",
                  ]}
                >
                  <span class="text-decorative-small text-text-faint uppercase">
                    {slot.label}
                  </span>

                  <ul class="flex flex-col gap-4">
                    {slot.items.map((event) => (
                      <li class="text-body-medium text-text-default">
                        {event}
                      </li>
                    ))}
                  </ul>
                </div>
              </div>
            ))}
          </div>
        </div>
      </Fragment>
    ))}

    <div class="pointer-events-none absolute inset-0 z-0">
      <AgendaRainOverlay client:visible={{ rootMargin: "240px" }} />
    </div>
  </div>
</Section>
