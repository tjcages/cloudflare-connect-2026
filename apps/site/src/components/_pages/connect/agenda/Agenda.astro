---
import Button from "@/components/Button";
import DashedLine from "@/components/dashed-line/DashedLine";
import Eyebrow from "@/components/Eyebrow";
import Section from "@/layouts/Section.astro";
import { connectAgenda, connectHero } from "../data";
import AgendaTwizzlerOverlay from "./AgendaTwizzlerOverlay";
---

<Section
  class="scroll-mt-80"
  id="agenda"
  layout="sticky"
  eyebrow="Agenda"
  sectionEyebrow="Schedule"
  title="Agenda at-a-glance"
  description="Three days of keynotes, hands-on training, breakouts, and after-hours at Moscone West."
>
  <Button href={connectHero.primaryCta.href} size="large" slot="action">
    <span>Register Now</span>
  </Button>

  <div data-agenda-twizzler-root class="relative flex flex-col gap-48 p-40">
    {connectAgenda.map((item, index) => (
      <Fragment>
        {index > 0 && (
          <div class="relative h-0">
            <DashedLine
              className="absolute inset-x-0 -top-0.5 w-full text-border-dashed"
              direction="horizontal"
            />
          </div>
        )}

        <div class="flex flex-col gap-16">
          <div
            data-agenda-twizzler-aperture
            class="relative h-200 overflow-clip bg-background-surface after:inside-border after:z-20 after:border-border-muted"
          >
            <div class="relative z-10 flex size-full flex-col justify-end gap-8 p-32">
              <Eyebrow
                client:visible
                direction="left"
                title={item.day}
                variant="faint"
              />
              <div class="text-heading-h3 text-orange-900">{item.date}</div>
            </div>
          </div>

          <p class="text-body-medium text-text-default">{item.body}</p>
        </div>
      </Fragment>
    ))}

    <div class="pointer-events-none absolute inset-0 z-0">
      <AgendaTwizzlerOverlay client:visible={{ rootMargin: "240px" }} />
    </div>
  </div>
</Section>
