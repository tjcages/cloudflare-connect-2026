---
import Container from "@/components/Container.astro";
import SectionEyebrow from "@/components/SectionEyebrow.astro";
import { connectSpeakers } from "../data";
import SpeakerShaderOverlay from "./SpeakerShaderOverlay";
---

<Container class="scroll-mt-80" id="speakers">
  <SectionEyebrow slot="beforeBleed" text="Speakers" />

  <div class="h-80"></div>

  <div class="px-80 pb-40 max-lg:px-24">
    <h2 class="mb-16 text-heading-h2 text-text-base">Meet our speakers</h2>
    <p class="max-w-640 text-body-large text-text-base">
      Learn from and network with industry leaders shaping the modern Internet.
    </p>
  </div>

  <div
    data-speaker-shader-root
    class="relative grid grid-cols-3 gap-y-40 p-40 before:inside-border before:border-border-muted max-lg:grid-cols-2 max-lg:p-16 max-sm:grid-cols-1"
  >
    {connectSpeakers.map((speaker, index) => (
      <div class="flex flex-col gap-24 px-24">
        <div
          data-speaker-index={index}
          data-speaker-shader-aperture
          class="relative h-320 w-full overflow-clip bg-background-surface after:inside-border after:border-border-muted"
        >
          <img
            src={speaker.image}
            alt={speaker.name}
            class="size-full object-cover object-top opacity-0"
            loading="lazy"
            decoding="async"
            width={320}
            height={320}
          />
        </div>
        <div>
          <div class="mb-8 text-label-medium text-text-base">
            {speaker.name}
          </div>
          <div class="text-body-small text-text-default">{speaker.role}</div>
        </div>
      </div>
    ))}
    <div class="pointer-events-none absolute inset-0 z-10">
      <SpeakerShaderOverlay client:visible={{ rootMargin: "240px" }} />
    </div>
  </div>

  <div class="h-80"></div>
</Container>
