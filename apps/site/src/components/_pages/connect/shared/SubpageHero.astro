---
import Button from "@/components/Button";
import CornerDots from "@/components/CornerDots";
import Eyebrow from "@/components/Eyebrow";
import ConnectHeroTwizzler from "../hero/ConnectHeroTwizzler";

interface Cta {
  text: string;
  href: string;
}

interface Props {
  eyebrow: string;
  title: string;
  body: string;
  primaryCta: Cta;
  secondaryCta?: Cta;
}

const { eyebrow, title, body, primaryCta, secondaryCta } = Astro.props;
---

{/*
  Same shell as the homepage hero: full-width max-w-1200 column, isolate +
  overflow clip so the Twizzler/rain stack sits in the lower band without
  escaping the grid frame.
*/}
<div
  class="relative isolate mx-auto w-full min-h-760 max-w-1200 overflow-hidden before:inside-border-b before:border-border-default md:min-h-616"
>
  <CornerDots count={4} faintClassName="z-30" />

  <div
    class="pointer-events-none absolute inset-x-0 -bottom-48 z-0 h-320 md:-bottom-96 md:h-520"
    aria-hidden="true"
  >
    <ConnectHeroTwizzler client:load posterSrc="/connect/twizzler-poster.png" />
  </div>

  <div
    class="relative z-10 flex flex-col gap-32 px-24 pt-48 pb-160 md:flex-row md:justify-between md:gap-0 md:px-80 md:pt-80"
  >
    <div class="flex w-full flex-col items-start md:w-440">
      <Eyebrow
        client:visible
        direction="left"
        title={eyebrow}
        variant="faint"
      />

      <h1 class="mt-24 text-heading-hero text-text-base">{title}</h1>
    </div>

    <div class="w-full self-start py-4 md:w-480 md:self-end md:py-0">
      <p class="text-body-large text-text-base">{body}</p>

      <div class="mt-40 flex flex-wrap items-center gap-12">
        <Button className="px-14" href={primaryCta.href} size="large">
          <span>{primaryCta.text}</span>
        </Button>
        {secondaryCta && (
          <Button href={secondaryCta.href} size="large" variant="secondary">
            <span>{secondaryCta.text}</span>
          </Button>
        )}
      </div>
    </div>
  </div>

  <div class="relative z-10 h-80"></div>
</div>
