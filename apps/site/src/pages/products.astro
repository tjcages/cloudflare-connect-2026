---
import Catalog from "@/components/catalog/Catalog";
import CatalogHero from "@/components/catalog/CatalogHero.astro";
import { catalogProductGroups } from "@/constants/products";
import Layout from "@/layouts/Layout.astro";
---

<Layout
  title="Cloudflare Products - Build, Deploy, and Scale Applications"
  description="Everything you need to build, deploy, and scale applications on Cloudflare's global network. Browse compute, storage, AI, media, security, and network products."
>
  <CatalogHero>
    <Fragment slot="heading">Cloudflare Products</Fragment>
    <Fragment slot="description">
      Everything you need to build, deploy, and scale <br />applications on
      Cloudflare's global network.
    </Fragment>
  </CatalogHero>
  <Catalog
    client:load
    categoriesLabel="Product categories"
    columns={3}
    groups={catalogProductGroups}
    noun={{ singular: "product", plural: "products" }}
    searchPlaceholder={'Search for a product (eg: "Workers")'}
  />
</Layout>
