---
import RegisterCta from "@/components/_pages/connect/cta/RegisterCta.astro";
import {
  universityFaq,
  universityHero,
  universityIncluded,
  universityPageMeta,
  universitySchedule,
  universityWhy,
} from "@/components/_pages/connect/page-data/university";
import AgendaStripeAperture from "@/components/_pages/connect/shared/AgendaStripeAperture.astro";
import AgendaStripeRoot from "@/components/_pages/connect/shared/AgendaStripeRoot.astro";
import FaqList from "@/components/_pages/connect/shared/FaqList.astro";
import SubpageHero from "@/components/_pages/connect/shared/SubpageHero.astro";
import Item from "@/components/features/Item.astro";
import DashedLineGrid from "@/components/dashed-line/DashedLineGrid";
import Eyebrow from "@/components/Eyebrow";
import Section from "@/layouts/Section.astro";
import Layout from "@/layouts/Layout.astro";
---

<Layout
  title={universityPageMeta.title}
  description={universityPageMeta.description}
  cta={false}
  nav="connect"
>
  <SubpageHero {...universityHero} />

  <Section
    class="scroll-mt-80"
    layout="center"
    eyebrow="Training"
    sectionEyebrow="Training"
    title={universityWhy.title}
    description={universityWhy.body}
    headerClass="pb-72! max-lg:pb-40!"
  >
    <div
      class="relative grid grid-cols-2 before:inside-border before:border-border-default max-lg:grid-cols-1"
    >
      {universityWhy.features.map((feature) => (
        <Item
          class="h-full min-h-262 max-lg:min-h-0"
          iconName={feature.iconName}
          title={feature.title}
        >
          {feature.body}
        </Item>
      ))}

      <div class="pointer-events-none absolute inset-0 max-lg:hidden">
        <DashedLineGrid
          client:visible={{ rootMargin: "200px" }}
          columns={2}
          rows={1}
        />
      </div>
    </div>
  </Section>

  <Section
    class="scroll-mt-80"
    layout="sticky"
    eyebrow="Schedule"
    sectionEyebrow="Schedule"
    title={universitySchedule.title}
    description={universitySchedule.body}
  >
    <AgendaStripeRoot class="flex flex-col gap-48 p-40 max-lg:gap-24 max-lg:p-16">
      {universitySchedule.days.map((day) => (
        <div class="flex flex-col gap-16">
          <AgendaStripeAperture class="h-200 max-lg:h-160">
            <Eyebrow
              client:visible
              direction="left"
              title={day.label}
              variant="faint"
            />
            <div class="text-heading-h3 text-orange-900">{day.date}</div>
          </AgendaStripeAperture>

          <div class="flex flex-col gap-8">
            <div class="text-heading-h3 text-balance text-text-base">
              {day.title}
            </div>
            <p class="text-body-medium text-pretty text-text-default">
              {day.body}
            </p>
          </div>
        </div>
      ))}
    </AgendaStripeRoot>
  </Section>

  <Section
    class="scroll-mt-80"
    layout="center"
    eyebrow="Included"
    sectionEyebrow="Pass"
    title={universityIncluded.title}
    description={universityIncluded.intro}
    headerClass="pb-72! max-lg:pb-40!"
  >
    <div
      class="relative grid grid-cols-2 before:inside-border before:border-border-default max-lg:grid-cols-1"
    >
      {universityIncluded.items.map((item) => (
        <Item
          class="h-full min-h-262 max-lg:min-h-0"
          iconName={item.iconName}
          title={item.title}
        >
          {item.body}
        </Item>
      ))}

      <div class="pointer-events-none absolute inset-0 max-lg:hidden">
        <DashedLineGrid
          client:visible={{ rootMargin: "200px" }}
          columns={2}
          rows={2}
        />
      </div>
    </div>

    <Fragment slot="info">
      <span class="contents text-label-x-small">Note:</span>{" "}
      {universityIncluded.note}
    </Fragment>
  </Section>

  <Section
    class="scroll-mt-80"
    id="faq"
    layout="center"
    eyebrow="FAQ"
    sectionEyebrow="FAQ"
    title="Frequently asked questions"
    description="University pass, training, and certification."
    headerClass="pb-72! max-lg:pb-40!"
  >
    <div
      class="mx-auto w-full max-w-720 px-40 pt-80 pb-80 max-lg:px-16 max-lg:pt-32 max-lg:pb-32"
    >
      <FaqList items={universityFaq} />
    </div>
  </Section>

  <RegisterCta />
</Layout>
