---
import RegisterCta from "@/components/_pages/connect/cta/RegisterCta.astro";
import {
  faqContactEmail,
  faqGroups,
  faqPageMeta,
} from "@/components/_pages/connect/page-data/faq";
import FaqList from "@/components/_pages/connect/shared/FaqList.astro";
import Icon from "@/components/icon/Icon";
import Section from "@/layouts/Section.astro";
import Layout from "@/layouts/Layout.astro";
---

<Layout
  title={faqPageMeta.title}
  description={faqPageMeta.description}
  cta={false}
  nav="connect"
>
  <Section class="scroll-mt-80" layout="headerless" sectionEyebrow="FAQ">
    <h1 class="sr-only">Frequently asked questions</h1>

    <div
      class="mx-auto flex w-full max-w-720 flex-col gap-64 px-40 py-40 max-lg:gap-40 max-lg:px-16 max-lg:py-24"
    >
      {faqGroups.map((group) => (
        <div class="flex flex-col">
          <h2 class="text-heading-h4 text-balance text-text-base">
            {group.title}
          </h2>
          <FaqList items={group.items} />
        </div>
      ))}

      <div
        class="relative flex h-80 items-center gap-20 bg-background-surface px-40 text-body-x-small text-text-default max-lg:h-auto max-lg:px-20 max-lg:py-16"
      >
        <div
          class="relative flex-center size-40 shrink-0 rounded-full bg-background-surface before:inside-border before:border-border-default"
        >
          <Icon name="info-simple" size={20} className="text-icon-default" />
        </div>
        <div class="min-w-0 text-pretty">
          Still have questions? Email{" "}
          <a
            class="text-label-x-small text-orange-900"
            href={`mailto:${faqContactEmail}`}
          >
            {faqContactEmail}
          </a>
          .
        </div>
      </div>
    </div>
  </Section>

  <RegisterCta />
</Layout>
