---
import RegisterCta from "@/components/_pages/connect/cta/RegisterCta.astro";
import BadgePage from "@/components/_pages/connect/badge/BadgePage";
import Layout from "@/layouts/Layout.astro";
---

<Layout
  title="Badge - Cloudflare Connect 2026 | Cloudflare"
  description="Create a unique Cloudflare Connect 2026 badge — pick a lab color scheme, add your name and company, and share a URL."
  cta={false}
  nav="connect"
>
  <BadgePage client:only="react">
    <div
      class="relative mx-auto min-h-760 bg-background-base before:inside-border-b before:border-border-default md:min-h-800"
      slot="fallback"
    >
    </div>
  </BadgePage>
  <RegisterCta />
</Layout>
