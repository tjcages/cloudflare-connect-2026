---
import RegisterCta from "@/components/_pages/connect/cta/RegisterCta.astro";
import { REGISTER_URL } from "@/components/_pages/connect/data";
import {
  partnerAwards,
  partnerExtend,
  partnerFaq,
  partnerHero,
  partnerPageMeta,
  partnerStay,
  partnerWhy,
} from "@/components/_pages/connect/page-data/partner";
import AgendaStripeAperture from "@/components/_pages/connect/shared/AgendaStripeAperture.astro";
import AgendaStripeRoot from "@/components/_pages/connect/shared/AgendaStripeRoot.astro";
import FaqList from "@/components/_pages/connect/shared/FaqList.astro";
import SubpageHero from "@/components/_pages/connect/shared/SubpageHero.astro";
import Item from "@/components/features/Item.astro";
import Button from "@/components/Button";
import DashedLineGrid from "@/components/dashed-line/DashedLineGrid";
import Eyebrow from "@/components/Eyebrow";
import Section from "@/layouts/Section.astro";
import Layout from "@/layouts/Layout.astro";
---

<Layout
  title={partnerPageMeta.title}
  description={partnerPageMeta.description}
  cta={false}
  nav="connect"
>
  <SubpageHero {...partnerHero} />

  <Section
    class="scroll-mt-80"
    layout="center"
    eyebrow="Why attend"
    sectionEyebrow="Why attend"
    title={partnerWhy.title}
    description={partnerWhy.body}
    headerClass="pb-72! max-lg:pb-40!"
  >
    <div
      class="relative grid grid-cols-2 before:inside-border before:border-border-default max-lg:grid-cols-1"
    >
      {partnerWhy.items.map((item) => (
        <Item
          class="h-full min-h-262 max-lg:min-h-0"
          iconName={item.iconName}
          title={item.title}
        >
          {item.body}
        </Item>
      ))}

      <div class="pointer-events-none absolute inset-0 max-lg:hidden">
        <DashedLineGrid
          client:visible={{ rootMargin: "200px" }}
          columns={2}
          rows={2}
        />
      </div>
    </div>

    <Fragment slot="info">
      <span class="contents text-label-x-small">
        {partnerWhy.featuredSpeaker.label}:
      </span>{" "}
      {partnerWhy.featuredSpeaker.name} — {partnerWhy.featuredSpeaker.role}
    </Fragment>
  </Section>

  <Section
    class="scroll-mt-80"
    layout="sticky"
    eyebrow="Recognition"
    sectionEyebrow="Awards"
    title={partnerAwards.title}
    description={partnerAwards.body}
  >
    <AgendaStripeRoot class="p-40 max-lg:p-16">
      <AgendaStripeAperture class="min-h-400 max-lg:min-h-220">
        <Eyebrow
          client:visible
          direction="left"
          title="Recognition"
          variant="faint"
        />
        <div class="text-heading-h3 text-orange-900">Partner Awards</div>
      </AgendaStripeAperture>
    </AgendaStripeRoot>
  </Section>

  <Section
    class="scroll-mt-80"
    layout="sticky"
    eyebrow="Oct 19–21"
    sectionEyebrow="Connect"
    title={partnerExtend.title}
    description={partnerExtend.body}
  >
    <Button slot="action" className="w-fit" href={REGISTER_URL} size="large">
      <span>Register for Connect</span>
    </Button>

    <AgendaStripeRoot class="flex flex-col gap-24 p-40 max-lg:gap-16 max-lg:p-16">
      <div class="flex flex-col gap-16">
        <AgendaStripeAperture class="h-200 max-lg:h-160">
          <Eyebrow
            client:visible
            direction="left"
            title="Oct 19–21"
            variant="faint"
          />
          <div class="text-heading-h3 text-orange-900">{partnerStay.title}</div>
        </AgendaStripeAperture>
        <p class="text-body-medium text-pretty text-text-default">{partnerStay.body}</p>
      </div>
    </AgendaStripeRoot>
  </Section>

  <Section
    class="scroll-mt-80"
    id="faq"
    layout="center"
    eyebrow="FAQ"
    sectionEyebrow="FAQ"
    title="Frequently asked questions"
    description="Eligibility, registration types, and what to expect."
    headerClass="pb-72! max-lg:pb-40!"
  >
    <div
      class="mx-auto w-full max-w-720 px-40 pt-80 pb-80 max-lg:px-16 max-lg:pt-32 max-lg:pb-32"
    >
      <FaqList items={partnerFaq} />
    </div>
  </Section>

  <RegisterCta />
</Layout>
