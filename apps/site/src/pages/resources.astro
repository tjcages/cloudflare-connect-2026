---
import Catalog from "@/components/catalog/Catalog";
import CatalogHero from "@/components/catalog/CatalogHero.astro";
import { catalogResourceGroups } from "@/constants/resources";
import Layout from "@/layouts/Layout.astro";
---

<Layout
  title="Cloudflare Resources - Docs, Guides, and Learning Materials"
  description="Find the docs, guides, and learning materials to design, ship, and scale on Cloudflare. Browse resources to learn, build, explore, and get to know the company."
>
  <CatalogHero>
    <Fragment slot="heading">Cloudflare Resources</Fragment>
    <Fragment slot="description">
      Find the docs, guides, and learning materials to design, <br
        class="max-lg:hidden"
      />ship, and scale on Cloudflare.
    </Fragment>
  </CatalogHero>
  <Catalog
    client:load
    categoriesLabel="Resource categories"
    columns={2}
    groups={catalogResourceGroups}
    noun={{ singular: "resource", plural: "resources" }}
    searchPlaceholder={'Search for a resource (eg: "Blog")'}
  />
</Layout>
