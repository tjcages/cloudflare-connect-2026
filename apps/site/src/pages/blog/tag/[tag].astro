---
import BlogHeader from "@/components/_pages/blog/BlogHeader.astro";
import {
  POSTS,
  postsByTag,
  TAGS,
  tagsOf,
  type Tag,
} from "@/components/_pages/blog/data";
import FilterBar from "@/components/_pages/blog/FilterBar";
import FilterBarArchive from "@/components/_pages/blog/FilterBarArchive.astro";
import FilterBarGrid from "@/components/_pages/blog/FilterBarGrid.astro";
import FilterBarResults from "@/components/_pages/blog/FilterBarResults.astro";
import {
  blogDocumentTitle,
  TAG_GRID_SIZE,
} from "@/components/_pages/blog/view";
import Container from "@/components/Container.astro";
import Layout from "@/layouts/Layout.astro";

export function getStaticPaths() {
  return Object.values(TAGS)
    .filter((tag) => tag.count > 0)
    .map((tag) => ({ params: { tag: tag.slug }, props: { tag } }));
}

const { tag } = Astro.props as { tag: Tag };

const grid = postsByTag(tag.slug).slice(0, TAG_GRID_SIZE);

const tags = Object.values(TAGS).filter((entry) => entry.count > 0);

const records = POSTS.map((post) => ({
  slug: post.slug,
  text: `${post.title} ${post.excerpt} ${tagsOf(post)
    .map((entry) => entry.label)
    .join(" ")}`.toLowerCase(),
  tags: post.tags,
}));
---

<Layout
  title={blogDocumentTitle(tag.label)}
  description={`Posts tagged ${tag.label} on the Cloudflare Blog. Technical deep dives, product updates, and insights from the teams that are helping to build a better Internet.`}
>
  <div data-blog-page>
    <Container>
      <div class="relative flex flex-col gap-48 px-80 py-80">
        <BlogHeader
          eyebrow="NOW"
          title={tag.label}
          description="Technical deep dives, product updates, and insights from the teams that are helping to build a better Internet."
        />

        <FilterBar
          client:load
          documentTag={tag.slug}
          records={records}
          tags={tags}
        />
      </div>

      <div data-blog-default>
        <div class="relative px-40 pb-80">
          <FilterBarGrid posts={grid} />
        </div>
      </div>

      <FilterBarResults />
    </Container>

    <FilterBarArchive tag={tag.slug} />
  </div>
</Layout>
