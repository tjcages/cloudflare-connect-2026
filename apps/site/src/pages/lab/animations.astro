---
import type { AstroComponentFactory } from "astro/runtime/server/index.js";
import BrowserRenderingCanvas from "@/components/_pages/products/browser-rendering/full-stack/FullStackCanvas";
import Libraries from "@/components/_pages/products/browser-rendering/full-stack/libraries/Libraries.astro";
import Render from "@/components/_pages/products/browser-rendering/full-stack/Render.astro";
import Compute from "@/components/_pages/products/containers/full-stack/Compute.astro";
import ContainersCanvas from "@/components/_pages/products/containers/full-stack/FullStackCanvas";
import Sandbox from "@/components/_pages/products/containers/full-stack/Sandbox.astro";
import Secure from "@/components/_pages/products/containers/full-stack/Secure.astro";
import Enrich from "@/components/_pages/products/email-service/full-stack/enrich/Enrich.astro";
import EmailCanvas from "@/components/_pages/products/email-service/full-stack/FullStackCanvas";
import Reply from "@/components/_pages/products/email-service/full-stack/reply/Reply.astro";
import Route from "@/components/_pages/products/email-service/full-stack/Route.astro";
import Send from "@/components/_pages/products/email-service/full-stack/Send.astro";
import GithubIntegration from "@/components/_pages/products/pages/use-cases/GithubIntegration.astro";
import PagesCanvas from "@/components/_pages/products/pages/use-cases/UseCasesCanvas";
import SandboxContainers from "@/components/_pages/products/sandboxes/full-stack/containers/Containers.astro";
import SandboxesCanvas from "@/components/_pages/products/sandboxes/full-stack/FullStackCanvas";
import Interpreter from "@/components/_pages/products/sandboxes/full-stack/interpreter/Interpreter.astro";
import SdkControl from "@/components/_pages/products/sandboxes/full-stack/sdk-control/SdkControl.astro";
import Streaming from "@/components/_pages/products/sandboxes/full-stack/streaming/Streaming.astro";
import Automation from "@/components/_pages/products/workers-for-platforms/full-stack/automation/Automation.astro";
import WfpCanvas from "@/components/_pages/products/workers-for-platforms/full-stack/FullStackCanvas";
import UseCasesApi from "@/components/_pages/products/workers/use-cases/api/UseCasesApi.astro";
import UseCasesRun from "@/components/_pages/products/workers/use-cases/run/UseCasesRun.astro";
import UseCasesServerless from "@/components/_pages/products/workers/use-cases/serverless/UseCasesServerless.astro";
import WorkersCanvas from "@/components/_pages/products/workers/use-cases/UseCasesCanvas";
import Layout from "@/layouts/Layout.astro";

const cards: {
  name: string;
  page: string;
  hits: string;
  component: AstroComponentFactory;
  tall?: boolean;
}[] = [
  {
    name: "Render",
    page: "browser-rendering",
    hits: "nudgeHit y 1.5 · nudgeHit y −1.5",
    component: Render,
  },
  {
    name: "Libraries",
    page: "browser-rendering",
    hits: "hitChip ×2",
    component: Libraries,
  },

  { name: "Send", page: "email", hits: "hitChip", component: Send },
  {
    name: "Enrich",
    page: "email",
    hits: "reel hop, scaled to the pill",
    component: Enrich,
  },
  {
    name: "Route",
    page: "email",
    hits: "reel hop, scaled to the pill",
    component: Route,
  },
  {
    name: "Reply",
    page: "email",
    hits: "reel hop, scaled to the pill",
    component: Reply,
  },

  {
    name: "Automation",
    page: "workers-for-platforms",
    hits: "reel hop, scaled to the pill",
    component: Automation,
  },

  {
    name: "Compute",
    page: "containers",
    hits: "hitChip",
    component: Compute,
  },

  {
    name: "GitHub integration",
    page: "pages",
    hits: "hitChip · nudgeHit x 2",
    component: GithubIntegration,
  },

  {
    name: "API request",
    page: "workers",
    hits: "hitChip",
    component: UseCasesApi,
    tall: true,
  },
  {
    name: "Serverless",
    page: "workers",
    hits: "hopChip −3 @0.45s",
    component: UseCasesServerless,
    tall: true,
  },
  {
    name: "Run",
    page: "workers",
    hits: "hopChip −4 · −4 @0.08 · −3, all @0.45s",
    component: UseCasesRun,
    tall: true,
  },
  {
    name: "Secure",
    page: "containers",
    hits: "nudgeHit x 2",
    component: Secure,
  },
  {
    name: "Sandbox",
    page: "containers",
    hits: "nudgeHit x 2",
    component: Sandbox,
  },

  {
    name: "SDK-driven control",
    page: "sandboxes",
    hits: "hitChip · nudgeHit x 2",
    component: SdkControl,
  },

  {
    name: "Built on containers",
    page: "sandboxes",
    hits: "nudgeHit y −4 · hitChip",
    component: SandboxContainers,
  },

  {
    name: "Real-time streaming",
    page: "sandboxes",
    hits: "nudgeHit x 2",
    component: Streaming,
  },

  {
    name: "Interpreter",
    page: "sandboxes",
    hits: "hitChip · nudgeHit x 2",
    component: Interpreter,
  },
];
---

<Layout
  cta={false}
  description="Every small card animation on one page, for comparing hit timings."
  footer={false}
  header={false}
  title="Card animations"
>
  {import.meta.env.DEV ? (
    <main class="p-40">
      <h1 class="text-heading-h5 text-text-base">Card animations</h1>

      <p class="mt-8 max-w-760 text-body-small text-text-muted">
        Every small card animation at native size, on its own triggers and its
        own cycle. Heroes and full-width sections are excluded. The line under
        each card is the hit it fires when something lands on it.
      </p>

      <div class="mt-16 flex flex-wrap gap-x-24 gap-y-4 text-mono-x-small text-text-faint">
        <span>nudgeHit — translate, 0.35s, quart-out, counter −amount/3</span>
        <span>hopChip — translate y, 0.45s, house ease, counter −amp/4</span>
        <span>hitChip — scale, 0.45s, house ease</span>
      </div>

      <div
        class="mt-40 flex flex-wrap gap-x-40 gap-y-56"
        data-containers-fullstack-grid
        data-email-fullstack-grid
        data-fullstack-grid
        data-pages-usecases-grid
        data-sandboxes-fullstack-grid
        data-usecases-grid
        data-wfp-fullstack-grid
      >
        {cards.map(({ component: Component, name, page, hits, tall }) => (
          <div class="w-480">
            {tall ? (
              <div class="relative h-320 bg-background-surface after:inside-border after:z-1 after:border-border-muted">
                <div class="overlay overflow-clip">
                  <Component />
                </div>
              </div>
            ) : (
              <Component />
            )}

            <div class="mt-16 flex items-baseline justify-between gap-16">
              <span class="text-label-small text-text-base">{name}</span>

              <span class="text-mono-x-small text-text-faint">{page}</span>
            </div>

            <p class="mt-4 text-mono-x-small text-text-muted">{hits}</p>
          </div>
        ))}

        <script
          is:inline
          src="/src/components/_lab/align-audit/mount.ts"
          type="module"
        />

        <BrowserRenderingCanvas client:only="react" />
        <ContainersCanvas client:only="react" />
        <EmailCanvas client:only="react" />
        <PagesCanvas client:only="react" />
        <SandboxesCanvas client:only="react" />
        <WfpCanvas client:only="react" />
        <WorkersCanvas client:only="react" />
      </div>
    </main>
  ) : (
    <main class="p-40">
      <p class="text-body-small text-text-muted">Dev only.</p>
    </main>
  )}
</Layout>
