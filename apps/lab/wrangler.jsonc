{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // Keep in sync with root wrangler.jsonc — same Worker for all deploys.
  // Dashboard: https://dash.cloudflare.com/944ca70087298faa2e84783db46162c5/workers/services/view/connect-shader/production
  "name": "connect-shader",
  "main": "worker/index.ts",
  "compatibility_date": "2026-06-10",
  "account_id": "944ca70087298faa2e84783db46162c5",
  // Keep preview_urls in sync with root wrangler.jsonc (PR branch previews).
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
  },
  "vars": {
    "PRODUCTION_HOST": "connect-shader.off-brand.workers.dev",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "connect-shader-presets",
      "database_id": "1ce11267-4140-4338-9e78-3fad409fa161",
      "migrations_dir": "migrations",
    },
    {
      "binding": "PREVIEW_DB",
      "database_name": "connect-shader-presets-preview",
      "database_id": "aff5c9b6-02ff-4452-b662-ee72a7cacee7",
      "migrations_dir": "migrations",
    },
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "not_found_handling": "single-page-application",
  },
}
